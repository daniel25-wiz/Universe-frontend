# Environment configuration
#
# Copy this file to `.env` and adjust as needed. Never commit real secrets.
# Frontend env vars are embedded at build time by Vite and are public by design.

# API mode: "mock" uses the in-browser mock backend, "real" uses the HTTP client.
VITE_API_MODE=mock

# Base URL for the real backend (only used when VITE_API_MODE=real).
VITE_API_URL=http://localhost:8000/api

# Set to "off" to disable the 300–800ms artificial mock latency.
VITE_MOCK_LATENCY=

# Google OAuth client ID for the real "Continue with Google" sign-in
# (Web-application client; add your origins — e.g. http://localhost:5173 and
# your dev-tunnel URL — as Authorized JavaScript origins in Google Cloud
# Console). Leave empty to disable Google sign-in; the button then explains
# these setup steps instead of signing in.
VITE_GOOGLE_CLIENT_ID=669488455349-7cgi875vt95pi889c9r75n50f0uetnns.apps.googleusercontent.com
