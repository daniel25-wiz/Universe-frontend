# Environment configuration
#
# Copy this file to `.env` and adjust as needed. Never commit real secrets.
# Frontend env vars are embedded at build time by Vite and are public by design.

# API mode: "mock" uses the in-browser mock backend, "real" uses the HTTP client.
VITE_API_MODE=mock

# Base URL for the real backend (only used when VITE_API_MODE=real).
VITE_API_URL=http://localhost:8000/api

# Set to "off" to disable the 300–800ms artificial mock latency.
VITE_MOCK_LATENCY=
